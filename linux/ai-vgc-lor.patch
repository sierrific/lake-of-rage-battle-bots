+    async def _ladder_pause(self) -> None:
+        """Wait a random while before searching again. Other ladder bots re-search the moment a
+        match ends, so searching right away mostly pairs us with them; a random pause drifts us
+        out of step and lets us meet whoever (often a human) joins the queue meanwhile."""
+        if self.stop_after_match:
+            return
+        pause = random.uniform(*self.LADDER_PAUSE)
+        print(f"pausing {pause / 60:.1f} min before the next ladder search", flush=True)
+        end = time.time() + pause
+        while not self.stop_after_match and time.time() < end:
+            await asyncio.sleep(1)
