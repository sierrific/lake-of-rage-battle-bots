new file mode 100644
index 0000000..c314fd2
--- /dev/null
+++ b/src/ai_vgc/nn/messages.py
@@ -0,0 +1,165 @@
+"""Local conversation history. Never writes private messages to games or stdout."""
+from collections import deque
+from datetime import datetime, timezone
+import json
+import logging
+import os
+from pathlib import Path
+import re
+import sys
+
+MAX_BYTES = 5 * 1024 * 1024
+READ_BYTES = 1024 * 1024
+LIMIT = 300
+
+
+def user_id(name):
+    return re.sub(r"[^a-z0-9]", "", name.lstrip(" ~&@%+*#!").split("@", 1)[0].lower())
+
+
+def is_conversation(sender, text):
+    # Showdown embeds UI controls in chat/PM packets, including Bo3 ready buttons.
+    return (isinstance(sender, str) and bool(user_id(sender))
+            and isinstance(text, str) and bool(text)
+            and not re.match(r"^/(?:uhtmlchange|uhtml|raw|html|challenge)(?:\s|$)", text, re.I))
+
+
+class PrivateMessages(logging.Filter):
+    def filter(self, record):
+        # Keep server responses (recipient '~'), but never copy a player's PM to
+        # journal, diagnostics or an exception log. Challenge handling is unchanged.
+        text = record.getMessage()
+        if "|pm|" in text:
+            parts = text.split("|pm|", 1)[1].split("|", 2)
+            if len(parts) == 3 and parts[1].strip() != "~":
+                record.msg, record.args = "Private Showdown message received (local history).", ()
+                record.exc_info, record.exc_text = None, None
+        return True
+
+
+class History:
+    def __init__(self, root, account):
+        self.account = user_id(account)
+        self.path = Path(root) / ".messages" / (self.account + ".jsonl")
+        self.players = {}
+
+    def append(self, kind, sender, text, room="", timestamp=None):
+        if not self.account or not is_conversation(sender, text):
+            return
+        row = {"kind": kind, "sender": sender.lstrip(" ~&@%+*#!"), "text": text,
+               "room": room, "time": timestamp or datetime.now(timezone.utc).isoformat(),
+               "own": user_id(sender) == self.account}
+        self.path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+        if self.path.exists() and self.path.stat().st_size >= MAX_BYTES:
+            os.replace(self.path, self.path.with_suffix(".jsonl.1"))
+        fd = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
+        with os.fdopen(fd, "a", encoding="utf-8") as stream:
+            stream.write(json.dumps(row, ensure_ascii=False) + "\n")
+
+    def receive(self, message):
+        lines = message.split("\n")
+        room = lines.pop(0)[1:] if lines[0].startswith(">") else ""
+        if not room:
+            for line in lines:
+                p = line.split("|", 4)
+                if len(p) == 5 and p[1] == "pm" and user_id(p[3]) == self.account and user_id(p[2]) != self.account:
+                    self.append("pm", p[2], p[4])
+            return
+        if not room.startswith(("battle-", "game-")):
+            return
+        players = self.players.setdefault(room, {})
+        if len(self.players) > 128:
+            del self.players[next(iter(self.players))]
+        # Scan players first: init packets can contain older chat before player lines.
+        for line in lines:
+            p = line.split("|")
+            if len(p) >= 4 and p[1] == "player" and p[2] in ("p1", "p2"):
+                players[p[2]] = user_id(p[3])
+        for line in lines:
+            p = line.split("|", 4)
+            timestamp = None
+            if len(p) >= 4 and p[1] == "c":
+                sender, text = p[2], "|".join(p[3:])
+            elif len(p) == 5 and p[1] == "c:":
+                sender, text = p[3], p[4]
+                try:
+                    timestamp = datetime.fromtimestamp(int(p[2]), timezone.utc).isoformat()
+                except (ValueError, OverflowError, OSError):
+                    pass
+            else:
+                continue
+            if self.account in players.values() and user_id(sender) in players.values():
+                self.append("chat", sender, text, room, timestamp)
+        if "|deinit" in lines:
+            self.players.pop(room, None)
+
+
+def install(player):
+    client = player.ps_client
+    history = History(player.save_dir.parent, client.account_configuration.username)
+    original = client._handle_message
+    client.logger.addFilter(PrivateMessages())
+    failed = False
+
+    async def receive(message):
+        nonlocal failed
+        try:
+            history.receive(message)
+        except OSError:
+            if not failed:
+                client.logger.warning("Could not save local conversation history.")
+                failed = True
+        return await original(message)
+
+    client._handle_message = receive
+
+
+def recent(root, account):
+    if not user_id(account):
+        return []
+    path = Path(root) / ".messages" / (user_id(account) + ".jsonl")
+    rows = deque(maxlen=LIMIT)
+    for item in (path.with_suffix(".jsonl.1"), path):
+        try:
+            with item.open("rb") as stream:
+                stream.seek(0, 2)
+                start = max(0, stream.tell() - READ_BYTES)
+                stream.seek(start)
+                if start:
+                    stream.readline()
+                for line in stream:
+                    try:
+                        row = json.loads(line)
+                        if (isinstance(row, dict) and row.get("kind") in ("pm", "chat")
+                                and is_conversation(row.get("sender"), row.get("text"))):
+                            rows.append(row)
+                    except (ValueError, UnicodeError):
+                        continue
+        except OSError:
+            continue
+    return list(rows)
+
+
+def panel(root, account, count, journal):
+    logs = []
+    for line in journal:
+        try:
+            entry = json.loads(line)
+            text = entry.get("MESSAGE", "")
+            if not isinstance(text, str) or "|pm|" in text:
+                continue
+            date = datetime.fromtimestamp(int(entry["__REALTIME_TIMESTAMP"]) / 1e6, timezone.utc)
+            logs.append({"kind": "log", "text": text, "time": date.isoformat()})
+        except (ValueError, KeyError, TypeError, OverflowError, OSError):
+            continue
+    print("---log---")
+    for row in logs[-count:]:
+        print(row["text"])
+    print("---historico---")
+    rows = logs + recent(root, account)
+    for row in sorted(rows, key=lambda row: row.get("time", ""))[-LIMIT:]:
+        print(json.dumps(row, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    panel(sys.argv[1], sys.argv[2], min(300, max(1, int(sys.argv[3]))), sys.stdin)
