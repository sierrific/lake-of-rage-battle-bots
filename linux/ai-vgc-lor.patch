+    async def _search_until_match(self) -> bool:
+        """Search the ladder until a battle starts (True), or until a graceful stop (False).
+        Showdown can drop a /search without telling us ("typing too quickly"); poke-env would then
+        wait for a battle forever, so a search with no match in SEARCH_RETRY is cancelled and redone.
+        Called holding _battle_start_condition, so a battle start can't slip between two waits."""
+        while True:
+            await self.ps_client.search_ladder_game(self._format, self.next_team)
+            start = time.time()
+            while not self.stop_after_match and time.time() - start < self.SEARCH_RETRY:
+                try:
+                    await asyncio.wait_for(self._battle_start_condition.wait(), 5)
+                    return True
+                except asyncio.TimeoutError:
+                    pass
+            await self.ps_client.send_message("/cancelsearch")
+            if self.stop_after_match:
+                return False
+            print(f"no match in {self.SEARCH_RETRY // 60} min: searching again", flush=True)
+            await asyncio.sleep(2)
