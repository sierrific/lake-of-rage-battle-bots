@@ -0,0 +1,81 @@
+"""Account-level presentation and pacing; never changes the battle policy or its RNG.
+
+Ranges are design choices informed by low-score opponents in the LoR coleta,
+not a fitted human model. See README for the dated sample and its limitations.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+import random
+import re
+
+
+@dataclass(frozen=True)
+class Profile:
+    key: str
+    label: str
+    avatar: int
+    move: tuple[float, float, float]  # low, high, mode (total seconds including compute)
+    preview: tuple[float, float, float]
+    pause: tuple[float, float, float]
+    greetings: tuple[str, ...]
+    endings: tuple[str, ...]
+
+
+PROFILES = (
+    Profile('reservado', 'Reservado', 43, (9, 20, 14), (18, 30, 22), (60, 240, 120),
+            ("glhf! I'm a LoR bot.", "LoR bot here. gl hf", "gl! I'm a LoR bot."),
+            ('gg', 'gg wp', 'wp, gg')),
+    Profile('cordial', 'Cordial', 68, (10, 24, 17), (20, 35, 25), (90, 300, 180),
+            ("Hi! I'm a LoR bot. Have fun!", "LoR bot here. Good luck, have fun!",
+             "Hey! I'm a LoR bot. glhf!"),
+            ('gg, thanks for the game!', 'well played, gg!', 'gg! good luck in your next games')),
+    Profile('analitico', 'Analítico', 54, (13, 26, 20), (23, 40, 29), (120, 300, 210),
+            ("I'm a LoR bot. Good luck!", "LoR bot ready. glhf!", "Hi, I'm a LoR bot. gl hf!"),
+            ('gg, well played', 'thanks for the game, gg', 'gg wp!')),
+    Profile('energetico', 'Energético', 90, (8, 21, 13), (17, 29, 21), (60, 210, 100),
+            ("LoR bot here. Let's play, glhf!", "I'm a LoR bot. Have a good game!",
+             "Ready! I'm a LoR bot. glhf!"),
+            ('gg! wp!', 'good game, wp!', 'gg, thanks!')),
+    Profile('tranquilo', 'Tranquilo', 120, (11, 25, 18), (21, 38, 27), (120, 300, 220),
+            ("Hey, I'm a LoR bot. Have fun!", "LoR bot here. Have a good game!",
+             "I'm a LoR bot. gl hf :)"),
+            ('gg, have a good one!', 'gg, thanks for playing', 'gg wp :)')),
+)
+
+
+def profile_for(account: str, selection: str = 'auto') -> Profile | None:
+    """The normalized account keeps its profile across restarts, PCs and Bo3 games."""
+    if selection == 'classico':
+        return None
+    if selection != 'auto':
+        for profile in PROFILES:
+            if profile.key == selection:
+                return profile
+        raise ValueError('personalidade inválida: use auto, classico, ' + ', '.join(p.key for p in PROFILES))
+    account_id = re.sub(r'[^a-z0-9]', '', account.lower())
+    digest = hashlib.sha256(account_id.encode('utf-8')).digest()
+    return PROFILES[int.from_bytes(digest[:8], 'big') % len(PROFILES)]
+
+
+class Personality:
+    def __init__(self, profile: Profile, rng: random.Random | None = None):
+        self.profile = profile
+        # A separate stream avoids changing model/search choices when cosmetics are sampled.
+        self.rng = rng if rng is not None else random.Random()
+        self._last: dict[str, str] = {}
+
+    def decision_seconds(self, *, preview: bool = False, forced: bool = False) -> float:
+        limits = self.profile.preview if preview else (4, 10, 6) if forced else self.profile.move
+        return self.rng.triangular(*limits)
+
+    def pause_seconds(self) -> float:
+        return self.rng.triangular(*self.profile.pause)
+
+    def phrase(self, event: str) -> str:
+        phrases = self.profile.greetings if event == 'start' else self.profile.endings
+        choices = [s for s in phrases if s != self._last.get(event)]
+        phrase = self.rng.choice(choices)
+        self._last[event] = phrase
+        return phrase
