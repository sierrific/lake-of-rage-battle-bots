+# Moves the policy tends to rank far below attacks even when they're the right play (a Wide Guard
+# against a boosted spread move, see the 2026-10-29 replay analysis); search should always score them.
+PROTECTIVE = {"protect", "detect", "wideguard", "quickguard", "spikyshield", "kingsshield",
+              "banefulbunker", "silktrap", "burningbulwark", "obstruct"}
+
+
+@torch.no_grad()
+def protective_candidates(model: Policy, battle: DoubleBattle, obs: dict[str, np.ndarray], mask: np.ndarray,
+                          have: list[tuple[np.ndarray, float]]) -> list[tuple[np.ndarray, float]]:
+    """For each slot with a usable protective move: that move with the partner's most likely
+    action, unless `have` already has a candidate where the slot uses it."""
+    b = {key: torch.from_numpy(np.ascontiguousarray(v))[None] for key, v in obs.items()}
+    m = torch.from_numpy(mask)[None]
+    enc = model.encode(b)
+    lp_a = F.log_softmax(masked(model.slot_logits(enc, b, 0), m[:, 0]), -1)[0]
+    out = []
+    for pos, mon in enumerate(battle.active_pokemon):
+        if mon is None:
+            continue
+        for k, move in enumerate(list(mon.moves.values())[:4]):
+            act = 7 + 5 * k + 2  # a move with no target
+            if move.id not in PROTECTIVE or not mask[pos, act] or any(a[pos] == act for a, _ in have + out):
+                continue
+            if pos == 0:
+                prev = torch.tensor([act])
+                lp_b = F.log_softmax(masked(model.slot_logits(enc, b, 1, prev), slot_b_mask(m[:, 1], prev)), -1)[0]
+                a1 = int(lp_b.argmax())
+                out.append((np.array([act, a1]), (lp_a[act] + lp_b[a1]).item()))
+                continue
+            for a0 in lp_a.topk(min(4, int(mask[0].sum()))).indices.tolist():
