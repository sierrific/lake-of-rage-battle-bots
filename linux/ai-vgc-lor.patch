+// A pivot (U-turn, Flip Turn, Parting Shot...) or Emergency Exit stops the turn with a switch
+// request for a Pokemon that is still alive; without an answer the rest of the turn (usually the
+// other side's moves) never happens and the playout is scored mid-turn. Answer those with the
+// first legal switch-in ("default") until the turn ends. Replacements for fainted Pokemon come
+// after the turn and are left as before.
+function finishTurn(battle) {
+  for (let i = 0; i < 8 && !battle.ended && battle.midTurn; i++) {
+    const pending = battle.sides.filter(side => {
+      const req = side.activeRequest;
+      return req && !req.wait && req.forceSwitch &&
+        side.active.some((p, j) => req.forceSwitch[j] && p && !p.fainted);
+    });
+    if (!pending.length) return;
+    for (const side of pending) battle.choose(side.id, 'default');
+  }
+}
