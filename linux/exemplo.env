# Um arquivo destes por bot em /etc/lor-bots/<nome>.env; ligue com
#   sudo systemctl enable --now lor-bot@<nome>
# (no PC o painel cria e cuida do /etc/lor-bots/bot.env sozinho).

# Conta do bot no Showdown (registrada no site oficial; vale também no nosso servidor).
BOT=LoRBot1
# Linux sem interface: modo antigo explícito. O painel Windows usa LOGIN=navegador.
# Trocar a autenticação não remove nem impede uma classificação aplicada pelo Showdown.
LOGIN=senha
# Ausente = /blockbots; crie este arquivo para /allowbots (lido no login e antes da próxima busca).
PERMITIR_BOTS_ARQUIVO=/etc/lor-bots/exemplo.permitir-bots
# Ausente = esperar bots adversários conhecidos; presente = pular essa espera, inclusive em curso.
SEM_ESPERA_BOTS_ARQUIVO=/etc/lor-bots/exemplo.sem-espera-bots
# Ausente = completar decisões até 10–20 s; presente = enviar assim que a IA calcular.
# Sem esta variável, instalações manuais mantêm a velocidade anterior.
DECISOES_RAPIDAS_ARQUIVO=/etc/lor-bots/exemplo.decisoes-rapidas
# A senha num arquivo à parte (chmod 640, grupo bots), ou direto em PS_PASSWORD=...
SENHA_ARQUIVO=/etc/lor-bots/LoRBot1.senha

# Onde joga: "oficial" = play.pokemonshowdown.com; "lor" = showdown.sierverso.com.br.
SERVIDOR=oficial

# Modo e opções do scripts/bot.sh do Ai-vgc. Sempre passe --model: o padrão do bot.sh
# (mc-bo1-rnad-v3) não vem no repositório; o mc-bo3-rnad-v5 é o melhor modelo publicado.
#   --ladder --use MC371 MC196       ladder Bo3, um desses times por partida (--bo1 para Bo1)
#   --ladder --use LOR-meutime       ladder com um time salvo pelo painel
#   --accept --top 3                 aceita desafios de qualquer um
#   --accept Sier OutroMembro        só aceita desafios dessas contas
#   --challenge LoRBot2 10           desafia outro bot 10 vezes (treino bot x bot)
# No Bo3, --change-after-loss --counter-t1 0.5 fazem o bot mudar depois de perder um jogo da série.
# --search-prior 0.03 --search-protect: as mesmas opções de busca que o painel usa (veja o BUSCA do painel.sh).
MODO="--ladder --use MC371 MC196 --model data/models/mc-bo3-rnad-v5.pt --change-after-loss --counter-t1 0.5 --search-prior 0.03 --search-protect"
